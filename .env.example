# ==============================================================================
# Plantilla de Variables de Entorno - SGM-TB
# Copiar este archivo a .env y definir credenciales locales seguras
# ==============================================================================

# Conexión PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=tu_password_seguro_postgres

# Puerto de Exposición en el Host
ODOO_HOST_PORT=8070

# Configuración Traccar GPS (para integración posterior)
TRACCAR_WEBHOOK_SECRET=tu_bearer_token_secreto_aqui

# Puertos del servidor Traccar local (API/web y protocolo OsmAnd de Traccar Client)
TRACCAR_API_PORT=8082
TRACCAR_GPS_PORT=5055

# Cloudflare Tunnel con nombre (opcional, perfil "tunel-fijo"). El túnel rápido (perfil "tunel") no necesita token.
CLOUDFLARE_TUNNEL_TOKEN=
