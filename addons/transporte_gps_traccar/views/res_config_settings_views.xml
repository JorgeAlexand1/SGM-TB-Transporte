<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_gps" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Transporte GPS" string="Transporte GPS"
                     data-key="transporte_gps_traccar" groups="transporte_core.group_transporte_manager">
                    <h2>Servidor Traccar</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="traccar_url"/>
                                <div class="text-muted">URL pública (túnel Cloudflare hacia 8082) o interna de Traccar.</div>
                                <field name="traccar_url"/>
                                <label for="traccar_token"/>
                                <field name="traccar_token" password="True"/>
                                <label for="traccar_user"/>
                                <field name="traccar_user"/>
                                <label for="traccar_password"/>
                                <field name="traccar_password" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="gps_minutos_sin_senal"/>
                                <field name="gps_minutos_sin_senal"/>
                                <label for="gps_webhook_secret"/>
                                <field name="gps_webhook_secret" password="True"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_gps_settings" model="ir.actions.act_window">
        <field name="name">Ajustes GPS</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'transporte_gps_traccar'}</field>
    </record>

    <menuitem id="menu_gps_settings" name="Ajustes Traccar" parent="menu_gps_root"
              action="action_gps_settings" sequence="40" groups="transporte_core.group_transporte_manager"/>
</odoo>
