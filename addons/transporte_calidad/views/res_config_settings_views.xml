<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_calidad" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.calidad</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Calidad del Transporte" string="Calidad del Transporte"
                     data-key="transporte_calidad" groups="transporte_core.group_transporte_manager">
                    <h2>Tolerancias de evaluación de recorridos</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Horario</span>
                                <div class="text-muted">Ejemplo: parada 08:15, tolerancia 5 → 08:23 es retraso de 8 min.</div>
                                <label for="cal_tol_retraso_min"/>
                                <field name="cal_tol_retraso_min"/>
                                <label for="cal_tol_adelanto_min"/>
                                <field name="cal_tol_adelanto_min"/>
                                <label for="cal_tol_duracion_pct"/>
                                <field name="cal_tol_duracion_pct"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Desvío y señal GPS</span>
                                <label for="cal_ancho_corredor_m"/>
                                <field name="cal_ancho_corredor_m"/>
                                <label for="cal_fuera_consecutivas"/>
                                <field name="cal_fuera_consecutivas"/>
                                <label for="cal_gap_senal_min"/>
                                <field name="cal_gap_senal_min"/>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <button name="action_reevaluar_viajes" type="object" class="btn-primary"
                                        string="Guardar y reevaluar todos los viajes" icon="fa-refresh"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_calidad_settings" model="ir.actions.act_window">
        <field name="name">Ajustes de calidad</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'transporte_calidad'}</field>
    </record>
</odoo>
