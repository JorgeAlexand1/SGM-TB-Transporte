<odoo>
    <record id="view_techstore_supplier_tree" model="ir.ui.view">
        <field name="name">techstore.supplier.tree</field><field name="model">techstore.supplier</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="tax_id"/><field name="email"/><field name="phone"/></tree></field>
    </record>
    <record id="view_techstore_supplier_form" model="ir.ui.view">
        <field name="name">techstore.supplier.form</field><field name="model">techstore.supplier</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="tax_id"/><field name="email"/><field name="phone"/><field name="address"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_techstore_supplier" model="ir.actions.act_window"><field name="name">Proveedores</field><field name="res_model">techstore.supplier</field><field name="view_mode">tree,form</field></record>
</odoo>
