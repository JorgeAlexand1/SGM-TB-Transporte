<odoo>
    <record id="view_techstore_stock_movement_tree" model="ir.ui.view">
        <field name="name">techstore.stock.movement.tree</field><field name="model">techstore.stock.movement</field>
        <field name="arch" type="xml"><tree><field name="date"/><field name="product_id"/><field name="movement_type"/><field name="quantity"/><field name="note"/></tree></field>
    </record>
    <record id="view_techstore_stock_movement_form" model="ir.ui.view">
        <field name="name">techstore.stock.movement.form</field><field name="model">techstore.stock.movement</field>
        <field name="arch" type="xml"><form><sheet><group><field name="product_id"/><field name="movement_type"/><field name="quantity"/><field name="date"/><field name="note"/></group></sheet></form></field>
    </record>
    <record id="action_techstore_stock_movement" model="ir.actions.act_window"><field name="name">Movimientos</field><field name="res_model">techstore.stock.movement</field><field name="view_mode">tree,form</field></record>
</odoo>
