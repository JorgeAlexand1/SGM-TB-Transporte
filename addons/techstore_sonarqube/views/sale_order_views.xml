<odoo>
    <record id="view_techstore_sale_order_tree" model="ir.ui.view">
        <field name="name">techstore.sale.order.tree</field><field name="model">techstore.sale.order</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="customer_id"/><field name="date"/><field name="state"/><field name="total"/></tree></field>
    </record>
    <record id="view_techstore_sale_order_form" model="ir.ui.view">
        <field name="name">techstore.sale.order.form</field><field name="model">techstore.sale.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmar" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" type="object" string="Cancelar" attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet><group><field name="name"/><field name="customer_id"/><field name="date"/></group>
                <field name="line_ids"><tree editable="bottom"><field name="product_id"/><field name="quantity"/><field name="price"/><field name="discount"/><field name="subtotal" readonly="1"/></tree></field>
                <group><field name="subtotal" readonly="1"/><field name="tax" readonly="1"/><field name="total" readonly="1"/></group><field name="note"/></sheet>
            </form>
        </field>
    </record>
    <record id="action_techstore_sale_order" model="ir.actions.act_window"><field name="name">Ventas</field><field name="res_model">techstore.sale.order</field><field name="view_mode">tree,form</field></record>
</odoo>
