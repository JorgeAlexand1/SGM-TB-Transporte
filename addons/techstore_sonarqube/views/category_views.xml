<odoo>
    <record id="view_techstore_category_tree" model="ir.ui.view">
        <field name="name">techstore.category.tree</field>
        <field name="model">techstore.category</field>
        <field name="arch" type="xml">
            <tree><field name="name"/><field name="active"/></tree>
        </field>
    </record>
    <record id="view_techstore_category_form" model="ir.ui.view">
        <field name="name">techstore.category.form</field>
        <field name="model">techstore.category</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="active"/><field name="description"/></group></sheet></form>
        </field>
    </record>
    <record id="action_techstore_category" model="ir.actions.act_window">
        <field name="name">Categorías</field><field name="res_model">techstore.category</field><field name="view_mode">tree,form</field>
    </record>
</odoo>
